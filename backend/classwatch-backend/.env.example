# Banco de dados
DB_URL=jdbc:postgresql://localhost:5432/classwatch
DB_USER=classwatch
DB_PASSWORD=

# Authenticação (obrigatório): use ao menos 32 bytes aleatórios; nunca versione o valor real.
CLASSWATCH_JWT_SECRET=
CLASSWATCH_JWT_ISSUER=classwatch
CLASSWATCH_JWT_TTL_SECONDS=3600

# Opcional: cria a primeira conta de professor se ainda não houver professor.
# Remova após criar a conta. Nunca promove um estudante existente.
CLASSWATCH_BOOTSTRAP_TEACHER_EMAIL=
CLASSWATCH_BOOTSTRAP_TEACHER_PASSWORD=

# OpenAI
OPENAI_API_KEY=

# Opcionais
# PYTHON_PATH=python
# AI_SCRIPT_PATH=C:/caminho/para/classwatch/ai/transcricao.py
# WHISPER_MODEL=small
# OPENAI_MODEL=gpt-4o-mini
# AI_TIMEOUT_SECONDS=1800
# UPLOADS_DIR=uploads
# PORT=8080
# MAX_UPLOAD_SIZE=50MB
